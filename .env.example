# Research Engine — example environment configuration.
# Copy to `.env` and fill in values. `.env` is git-ignored and never committed.
# All variables are OPTIONAL: with none set, the engine runs fully offline with
# deterministic synthesis.

# ---- LLM provider (OpenRouter, the default) ----
# API key for OpenRouter (https://openrouter.ai/keys). Required only for live
# LLM-backed synthesis of the executive summary. Without it, the engine falls
# back to deterministic synthesis automatically.
OPENROUTER_API_KEY=

# Optional overrides for the OpenRouter provider:
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Engine settings ----
# RE_* variables override the built-in defaults. CLI flags override these.
# RE_MAX_SUBTOPICS=6
# RE_DOCUMENTS_PER_QUERY=3
# RE_OUTPUT_DIR=report
# RE_SESSIONS_DIR=sessions
# RE_LLM_ENABLED=true
# RE_LLM_MAX_TOKENS=1500
# RE_LOG_LEVEL=INFO

# ---- Claim-pipeline / candidate-gate knobs ----
# RE_EVALUATION_ENABLED=true             # set false to download every search candidate
# RE_MAX_CANDIDATES_PER_QUERY=8          # search results fetched (metadata only) per query
# RE_CANDIDATE_RELEVANCE_THRESHOLD=0.15  # min 0-1 title/snippet relevance to download
# RE_MIN_AUTHORITY=0.0                   # optional 0-1 authority gate (0 = never reject on authority)
# RE_MAX_PASSAGES=6                      # max relevant passages kept per document
# RE_PASSAGE_MIN_RELEVANCE=0.05          # min 0-1 passage relevance to keep it
# RE_VERIFICATION_ENABLED=true           # claim clustering / cross-source verification

# ---- v0.5 agent-loop / research-intelligence knobs ----
# RE_CONFIDENCE_THRESHOLD=0.7            # stop once overall confidence reaches this
# RE_MAX_ITERATIONS=3                    # agent-loop search budget (iterations)
# RE_MIN_CLAIM_IMPORTANCE=0.1            # claims below this 0-1 importance stay out of reasoning/report
# RE_MIN_ITERATION_GAIN=0.05             # stop when an iteration's knowledge gain falls below this
# RE_MIN_CONFIDENCE_DELTA=0.02           # stop when confidence stops moving by at least this much
# RE_MAX_SEARCH_TASKS_PER_ITERATION=6    # search tasks the adaptive planner emits per iteration
# RE_MAX_EQUIVALENCE_CHECKS=40           # borderline claim pairs the LLM equivalence judge reviews (0 = off)
