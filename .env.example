# Research Engine — example environment configuration.
# Copy to `.env` and fill in values. `.env` is git-ignored and never committed.
# All variables are OPTIONAL: with none set, the engine runs fully offline with
# deterministic synthesis.

# ---- LLM provider (OpenRouter, the default) ----
# API key for OpenRouter (https://openrouter.ai/keys). Required only for live
# LLM-backed synthesis of the executive summary. Without it, the engine falls
# back to deterministic synthesis automatically.
OPENROUTER_API_KEY=

# Optional overrides for the OpenRouter provider:
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Engine settings ----
# RE_* variables override the built-in defaults. CLI flags override these.
# RE_MAX_SUBTOPICS=6
# RE_DOCUMENTS_PER_QUERY=3
# RE_OUTPUT_DIR=report
# RE_SESSIONS_DIR=sessions
# RE_LLM_ENABLED=true
# RE_LLM_MAX_TOKENS=1500
# RE_LOG_LEVEL=INFO

# ---- v0.3 evidence-quality / verification knobs ----
# RE_RANKING_ENABLED=true          # set false to process every document (v0.2 behaviour)
# RE_RELEVANCE_THRESHOLD=0.12      # min 0-1 relevance for a document to be processed
# RE_MIN_AUTHORITY=0.0             # optional 0-1 authority gate (0 = never reject on authority)
# RE_MAX_PASSAGES=6                # max relevant passages kept per document
# RE_PASSAGE_MIN_RELEVANCE=0.05    # min 0-1 passage relevance to keep it
# RE_VERIFICATION_ENABLED=true     # claim clustering / cross-source verification
